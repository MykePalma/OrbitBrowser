<Window x:Class="Lite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Orbit" Icon="Assets/orbit.ico" Width="1280" Height="820" MinWidth="420" MinHeight="300"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontSize="13">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="2"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- tab strip -->
        <Grid x:Name="TabBar" Grid.Row="0" Background="{StaticResource Bg}" Height="38">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ListBox x:Name="TabList" Grid.Column="0" Margin="8,0,0,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderThickness="0" AllowDrop="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="TabList_SelectionChanged" Drop="TabList_Drop" PreviewMouseMove="TabList_MouseMove" PreviewMouseLeftButtonDown="TabList_Down">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="1,6,0,0"/>
                        <EventSetter Event="PreviewMouseDown" Handler="TabItem_MouseDown"/>
                        <EventSetter Event="MouseRightButtonUp" Handler="TabItem_RightClick"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" CornerRadius="8,8,0,0" Background="{StaticResource TabBg}" Width="{Binding TabWidth}" Height="32" Padding="8,0,4,0" ToolTip="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="tint" Panel.ZIndex="-1" IsHitTestVisible="False" Background="{Binding TintBrush}" Opacity="0.22" CornerRadius="8,8,0,0" Margin="-8,0,-4,0" Grid.ColumnSpan="4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <md:PackIcon Kind="ViewSplitVertical" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Acc}" Visibility="{Binding SplitVis}" ToolTip="In split view"/>
                                                <Image Source="{Binding Favicon}" Width="16" Height="16" Margin="0,0,6,0" Visibility="{Binding FavVis}"/>
                                                <TextBlock Text="{Binding Glyph}" Visibility="{Binding GlyphVis}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource Mut}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" Visibility="{Binding TitleVis}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource Fg}"/>
                                            <Button Grid.Column="2" Content="{Binding MuteGlyph}" Visibility="{Binding MuteVis}" Style="{StaticResource Flat}" Width="24" Height="24" FontSize="11" Click="TabMute_Click" ToolTip="Mute or unmute"/>
                                            <Button Grid.Column="3" Content="✕" Visibility="{Binding CloseVis}" Style="{StaticResource Flat}" Width="24" Height="24" FontSize="11" Click="TabClose_Click" ToolTip="Close tab"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Bar}"/><Setter TargetName="tint" Property="Opacity" Value="0.5"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <Button x:Name="NewTabBtn" Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Flat}" Width="24" Height="24" Margin="4,7,8,0" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click"><md:PackIcon Kind="Plus" Width="16" Height="16"/></Button>
            <StackPanel x:Name="CaptionBtns" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinBtn" Style="{StaticResource Caption}" ToolTip="Minimize" Click="Min_Click"><md:PackIcon Kind="WindowMinimize" Width="14" Height="14"/></Button>
                <Button x:Name="MaxBtn" Style="{StaticResource Caption}" ToolTip="Maximize" Click="Max_Click"><md:PackIcon x:Name="MaxIcon" Kind="WindowMaximize" Width="14" Height="14"/></Button>
                <Button x:Name="CloseBtn" Style="{StaticResource CaptionClose}" ToolTip="Close" Click="CloseWin_Click"><md:PackIcon Kind="Close" Width="16" Height="16"/></Button>
            </StackPanel>
            <Border x:Name="DropLine" Grid.ColumnSpan="4" Width="3" Height="30" CornerRadius="1.5" Background="{StaticResource Acc}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0" Visibility="Collapsed" IsHitTestVisible="False" Panel.ZIndex="50"/>
        </Grid>

        <!-- toolbar -->
        <Grid x:Name="Toolbar" Grid.Row="1" Background="{StaticResource Bar}" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                <Button x:Name="BackBtn" Content="←" Style="{StaticResource Flat}" ToolTip="Back (Alt+←)" Click="Back_Click"/>
                <Button x:Name="FwdBtn" Content="→" Style="{StaticResource Flat}" ToolTip="Forward (Alt+→)" Click="Fwd_Click"/>
                <Button x:Name="ReloadBtn" Content="⟳" Style="{StaticResource Flat}" ToolTip="Reload (F5)" Click="Reload_Click"/>
                <Button x:Name="HomeBtn" Content="⌂" Style="{StaticResource Flat}" ToolTip="Home (Alt+Home)" Click="Home_Click"/>
            </StackPanel>
            <Border x:Name="Omni" Grid.Column="1" Margin="8,6" CornerRadius="16" Background="{StaticResource Field}" BorderThickness="1" BorderBrush="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Lock" Margin="12,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource Mut}" Text=""/>
                    <TextBox x:Name="UrlBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}"
                             VerticalContentAlignment="Center" FontSize="14" Padding="2,0" PreviewKeyDown="Url_KeyDown" GotKeyboardFocus="Url_Focus" LostKeyboardFocus="Url_Lost" TextChanged="Url_Changed" PreviewMouseLeftButtonDown="Url_Click"/>
                    <Button x:Name="ShieldBtn" Grid.Column="2" Style="{StaticResource Flat}" Width="Auto" Height="28" MinWidth="30" Padding="6,0" Visibility="Collapsed" Click="Shield_Click" AutomationProperties.Name="Ad blocker" Margin="0,0,2,0">
                        <StackPanel Orientation="Horizontal"><md:PackIcon x:Name="ShieldIcon" Kind="ShieldCheckOutline" Width="18" Height="18" VerticalAlignment="Center"/><TextBlock x:Name="ShieldCount" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
                    </Button>
                    <TextBlock x:Name="ZoomLbl" Grid.Column="3" VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource Mut}" Cursor="Hand" ToolTip="Reset zoom" MouseDown="Zoom_Click"/>
                    <Button x:Name="StarBtn" Grid.Column="4" Content="☆" Style="{StaticResource Flat}" Width="28" Height="28" Margin="0,0,3,0" ToolTip="Bookmark this page (Ctrl+D)" Click="Star_Click"/>
                    <Popup x:Name="SuggPopup" PlacementTarget="{Binding ElementName=Omni}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" Focusable="False">
                        <ListBox x:Name="SuggList" Width="{Binding ActualWidth, ElementName=Omni}" MaxHeight="320" Background="{StaticResource Bar}" Foreground="{StaticResource Fg}" BorderBrush="#55FFFFFF" Focusable="False"
                                 PreviewMouseLeftButtonUp="Sugg_Click"/>
                    </Popup>
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                <Button x:Name="DlBtn" Content="⬇" Style="{StaticResource Flat}" ToolTip="Downloads (Ctrl+J)" Click="Downloads_Click"/>
                <Button x:Name="MenuBtn" Content="⋮" Style="{StaticResource Flat}" ToolTip="Menu" Click="Menu_Click"/>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="Prog" Grid.Row="2" Minimum="0" Maximum="1" Value="0" Height="2" Background="{StaticResource Bar}" Foreground="{StaticResource Acc}" BorderThickness="0" Visibility="Hidden"/>

        <!-- update bar -->
        <Border x:Name="UpdateBar" Grid.Row="3" Visibility="Collapsed" Background="#26FFFFFF" Padding="12,5">
            <DockPanel>
                <md:PackIcon Kind="ArrowUpBoldCircleOutline" Width="18" Height="18" Foreground="{StaticResource Acc}" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="UpdNow" Content="Restart to update" Style="{StaticResource Pill}" Click="UpdNow_Click"/>
                    <Button x:Name="UpdNotes" Content="What's new" Style="{StaticResource PillGhost}" Click="UpdNotes_Click"/>
                    <Button Content="Later" Style="{StaticResource PillGhost}" Click="UpdLater_Click"/>
                </StackPanel>
                <TextBlock x:Name="UpdText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- bookmarks bar -->
        <ScrollViewer x:Name="BmBar" Grid.Row="4" Background="{StaticResource Bar}" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" Height="30">
            <StackPanel x:Name="BmPanel" Orientation="Horizontal" Margin="8,0"/>
        </ScrollViewer>

        <!-- find bar -->
        <Border x:Name="FindBar" Grid.Row="5" Background="{StaticResource Bar}" Visibility="Collapsed" BorderBrush="#33FFFFFF" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="6,4">
                <TextBox x:Name="FindBox" Width="240" Background="{StaticResource Field}" Foreground="{StaticResource Fg}" CaretBrush="{StaticResource Fg}" BorderThickness="0" Padding="6,4" VerticalContentAlignment="Center"
                         TextChanged="Find_Changed" PreviewKeyDown="Find_Key"/>
                <TextBlock x:Name="FindCount" Width="64" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Mut}"/>
                <CheckBox x:Name="FindCase" Content="Aa" VerticalAlignment="Center" Foreground="{StaticResource Fg}" ToolTip="Match case" Click="Find_Changed" Margin="2,0,6,0"/>
                <Button Content="↑" Style="{StaticResource Flat}" Width="28" Height="28" Click="FindPrev_Click"/>
                <Button Content="↓" Style="{StaticResource Flat}" Width="28" Height="28" Click="FindNext_Click"/>
                <Button Content="✕" Style="{StaticResource Flat}" Width="28" Height="28" Click="FindClose_Click"/>
            </StackPanel>
        </Border>

        <!-- content -->
        <Grid x:Name="Content_" Grid.Row="6" Background="{StaticResource Bg}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext" Background="{StaticResource Bar}" Visibility="Collapsed" Panel.ZIndex="10"/>
            </Grid>
        <Border x:Name="Status" Grid.Row="7" Background="{StaticResource Bar}" Padding="8,2" Visibility="Collapsed">
            <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Mut}"/>
        </Border>
    </Grid>
</Window>
