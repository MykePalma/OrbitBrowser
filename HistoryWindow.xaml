<local:ThemedWindow x:Class="Lite.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Lite"
        Title="History" Width="860" Height="680" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="RowDelete" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- day heading: bold label, generous space above (proximity: rows belong to the heading above them) -->
        <DataTemplate DataType="{x:Type local:HistoryDay}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource TextStrong}" Margin="12,20,0,6"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:HistoryRowVm}">
            <Grid MinHeight="48" Margin="8,0,4,0" ToolTip="{Binding Url}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse Fill="{Binding Avatar}"/>
                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#12141A"/>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,6">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Host}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource TextCaption}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="12,0"/>
                <Button Grid.Column="3" Style="{StaticResource RowDelete}" ToolTip="Remove from history" Click="DeleteRow_Click" AutomationProperties.Name="Remove from history" Focusable="False">
                    <md:PackIcon Kind="Close" Width="16" Height="16"/>
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:HistoryMore}">
            <Button Content="{Binding Label}" Style="{StaticResource BtnGhost}" HorizontalAlignment="Center" Margin="0,12" Click="More_Click"/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <DockPanel Margin="24,24,24,16">
            <Button x:Name="ClearBtn" DockPanel.Dock="Right" Style="{StaticResource BtnDangerGhost}" Click="ClearAll_Click" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"><md:PackIcon Kind="DeleteOutline" Width="18" Height="18" VerticalAlignment="Center"/><TextBlock Text="Clear history…" Margin="8,0,0,0"/></StackPanel>
            </Button>
            <TextBlock Text="History" Style="{StaticResource TextTitle}" VerticalAlignment="Center"/>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource SearchBox}" Margin="24,0,24,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <md:PackIcon Kind="Magnify" Width="18" Height="18" Margin="12,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource Mut}"/>
                <TextBox x:Name="Search" Grid.Column="1" Style="{StaticResource FieldBare}" TextChanged="Search_Changed" PreviewKeyDown="Search_Key" AutomationProperties.Name="Search history"/>
                <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search your history" Style="{StaticResource TextCaption}" FontSize="14" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button x:Name="SearchClear" Grid.Column="2" Style="{StaticResource BtnIcon}" Width="28" Height="28" Margin="0,0,2,0" Visibility="Collapsed" ToolTip="Clear search" Click="SearchClear_Click" AutomationProperties.Name="Clear search">
                    <md:PackIcon Kind="Close" Width="14" Height="14"/>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Margin="16,0,8,0" SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="List_KeyDown" MouseDoubleClick="List_DoubleClick" AutomationProperties.Name="History list"/>

            <!-- empty states tell people what the area is for and what to do next -->
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Visibility="Collapsed">
                <md:PackIcon x:Name="EmptyIcon" Kind="History" Width="48" Height="48" Foreground="{StaticResource Mut}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource TextSubtitle}" TextAlignment="Center" Margin="0,16,0,0"/>
                <TextBlock x:Name="EmptyText" Style="{StaticResource TextCaption}" FontSize="14" TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0" Padding="24,10">
            <DockPanel>
                <TextBlock x:Name="Count" DockPanel.Dock="Left" Style="{StaticResource TextCaption}"/>
                <TextBlock DockPanel.Dock="Right" Text="Enter opens · Ctrl+Enter opens in a new tab · Delete removes" Style="{StaticResource TextCaption}" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</local:ThemedWindow>
