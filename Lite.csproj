<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>Orbit</AssemblyName>
    <ApplicationIcon>Assets\orbit.ico</ApplicationIcon>
    <Product>Orbit</Product>
    <RootNamespace>Lite</RootNamespace>
    <NoWarn>CS8632;CS0618;CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\orbit.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CefSharp.Wpf.HwndHost" Version="154.0.340" />
    <PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
  </ItemGroup>
</Project>
