<local:ThemedWindow x:Class="Lite.DownloadsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Lite"
        Title="Downloads" Width="720" Height="560" MinWidth="520" MinHeight="360" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <DataTemplate DataType="{x:Type local:DownloadEntry}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <md:PackIcon Kind="{Binding FileKind}" Width="32" Height="32" Foreground="{StaticResource Acc}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource TextCaption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <ProgressBar Value="{Binding Percent}" Style="{StaticResource Thin}" Margin="0,8,0,0" Visibility="{Binding Active, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Style="{StaticResource BtnIcon}" ToolTip="Open file" Click="Open_Click" Visibility="{Binding Finished, Converter={StaticResource B2V}}" AutomationProperties.Name="Open file"><md:PackIcon Kind="OpenInNew" Width="18" Height="18"/></Button>
                        <Button Style="{StaticResource BtnIcon}" ToolTip="Show in folder" Click="Show_Click" Visibility="{Binding Finished, Converter={StaticResource B2V}}" AutomationProperties.Name="Show in folder"><md:PackIcon Kind="FolderOpenOutline" Width="18" Height="18"/></Button>
                        <Button Style="{StaticResource BtnIcon}" ToolTip="Pause or resume" Click="Pause_Click" Visibility="{Binding Active, Converter={StaticResource B2V}}" AutomationProperties.Name="Pause or resume"><md:PackIcon Kind="{Binding PauseKind}" Width="18" Height="18"/></Button>
                        <Button Style="{StaticResource BtnIcon}" ToolTip="Cancel download" Click="Cancel_Click" Visibility="{Binding Active, Converter={StaticResource B2V}}" AutomationProperties.Name="Cancel download"><md:PackIcon Kind="Close" Width="18" Height="18"/></Button>
                        <Button Style="{StaticResource BtnIcon}" ToolTip="Remove from list" Click="Remove_Click" Visibility="{Binding Inactive, Converter={StaticResource B2V}}" AutomationProperties.Name="Remove from list"><md:PackIcon Kind="DeleteOutline" Width="18" Height="18"/></Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="24,24,24,16">
            <Button x:Name="ClearBtn" DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Click="Clear_Click" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="DeleteSweepOutline" Width="18" Height="18" VerticalAlignment="Center"/><TextBlock Text="Clear list" Margin="8,0,0,0"/></StackPanel></Button>
            <Button DockPanel.Dock="Right" Style="{StaticResource BtnGhost}" Click="Folder_Click" VerticalAlignment="Center" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><md:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" VerticalAlignment="Center"/><TextBlock Text="Open folder" Margin="8,0,0,0"/></StackPanel></Button>
            <TextBlock Text="Downloads" Style="{StaticResource TextTitle}" VerticalAlignment="Center"/>
        </DockPanel>
        <ItemsControl x:Name="ListView" Grid.Row="1" Margin="24,0,24,16" ItemsSource="{x:Static local:DownloadsWindow.Items}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl"><ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate>
            </ItemsControl.Template>
        </ItemsControl>
        <StackPanel x:Name="Empty" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="340">
            <md:PackIcon Kind="TrayArrowDown" Width="48" Height="48" Foreground="{StaticResource Mut}" HorizontalAlignment="Center"/>
            <TextBlock Text="No downloads yet" Style="{StaticResource TextSubtitle}" TextAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="Files you download appear here with their progress. Open the folder to see earlier downloads." Style="{StaticResource TextCaption}" FontSize="14" TextAlignment="Center" Margin="0,8,0,16"/>
            <Button Content="Open downloads folder" Style="{StaticResource Btn}" HorizontalAlignment="Center" Click="Folder_Click"/>
        </StackPanel>
    </Grid>
</local:ThemedWindow>
